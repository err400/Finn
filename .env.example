# Copy to backend/.env. Paths are relative to backend working directory.
FINN_DATABASE_URL=sqlite:///./finn.db
FINN_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# No external provider keys are required for local educational ingestion.
# Set a random private token to enable POST /api/v1/data/refresh.
FINN_INGEST_TOKEN=
# Defaults to backend/data; keep raw source captures out of the public repository.
# FINN_DATA_DIR=/absolute/path/to/private/finn-data

# Optional: leave blank to keep LLM synthesis explicitly unavailable.
FINN_LLM_MODEL=
FINN_LLM_API_KEY=
FINN_LLM_BASE_URL=https://api.openai.com/v1

# Optional issuer onboarding after checking the source terms and exact PDF URLs:
# FINN_PRIMARY_CATALOG_PATH=/absolute/path/to/reviewed-primary-sources.json
# FINN_REVIEWED_PRIMARY_HOSTS=["www.example-issuer.com"]
# HYDE_INFERENCE_API_KEY, HYDE_BASE_URL and HYDE_MODEL are read directly from
# the backend process environment and take precedence over FINN_LLM_* values.
# Never put an inference key in a VITE_ variable.

# The local backend automatically checks exchange sources while running.
FINN_AUTO_REFRESH_ENABLED=true
FINN_SOURCE_REFRESH_SECONDS=300

# Local defaults. For hosted review, configure these in Render, not in GitHub:
FINN_ACCESS_MODE=local
FINN_EPHEMERAL_STORAGE=false
FINN_BOOTSTRAP_ENABLED=false
FINN_STORAGE_BACKEND=local
# Durable cloud settings (backend only):
# FINN_DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@SESSION_POOLER:5432/postgres?sslmode=require
# FINN_STORAGE_BACKEND=supabase
# FINN_STORAGE_URL=https://PROJECT.supabase.co
FINN_STORAGE_BUCKET=finn-private
# FINN_STORAGE_KEY=  # Supabase server-side service_role key; never a VITE_ value

# Fixed submission deployment (no expiring model dependency):
FINN_LLM_ENABLED=false
FINN_SNAPSHOT_MODE=true

# Optional: keep [YOUR-PASSWORD] in FINN_DATABASE_URL and set the raw password privately:
# FINN_DATABASE_PASSWORD=
